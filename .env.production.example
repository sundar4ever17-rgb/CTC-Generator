# Copy to .env.production. No credentials belong in this file.
# Fill image references with the tested registry images pinned by @sha256 digest.
CTC_API_IMAGE=
CTC_WEB_IMAGE=
CADDY_IMAGE=
# DNS name only, without scheme or path. DNS A/AAAA must point to the host.
CTC_DOMAIN=
ACME_EMAIL=
# File paths populated by your secret manager. Never commit actual secret files.
DATABASE_URL_FILE=./.secrets/database_url
MIGRATOR_DATABASE_URL_FILE=./.secrets/migrator_database_url
POSTGRES_CA_FILE=./.secrets/postgres_ca.pem
BOOTSTRAP_ADMIN_PASSWORD_FILE=./.secrets/bootstrap_admin_password
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
DB_POOL_MAX_CONNS=20
